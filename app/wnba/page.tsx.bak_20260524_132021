import Link from "next/link";
import { createClient } from "@supabase/supabase-js";
import {
  ArrowLeft,
  ArrowRight,
  CalendarDays,
  ChevronRight,
  Clock,
  Shield,
  Trophy,
  Users,
} from "lucide-react";

export const dynamic = "force-dynamic";

type RawSearchParams =
  | Record<string, string | string[] | undefined>
  | Promise<Record<string, string | string[] | undefined>>;

type GameRow = {
  game_id: string;
  season: string;
  season_type: string;
  game_date: string;
  away_team_id: number | null;
  away_team_abbr: string;
  away_pts: number | null;
  away_wl: string | null;
  home_team_id: number | null;
  home_team_abbr: string;
  home_pts: number | null;
  home_wl: string | null;
  winner_abbr: string | null;
  updated_at?: string | null;
};

type DateRow = {
  game_date: string;
};

function getOne(value: string | string[] | undefined, fallback: string) {
  if (Array.isArray(value)) return value[0] ?? fallback;
  return value ?? fallback;
}

function fmtDate(value: string | null | undefined) {
  if (!value) return "Sin fecha";
  const date = new Date(`${value}T12:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("es-AR", {
    weekday: "long",
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}

function shortDate(value: string | null | undefined) {
  if (!value) return "—";
  const date = new Date(`${value}T12:00:00`);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("es-AR", {
    day: "2-digit",
    month: "2-digit",
  });
}

function qs(params: Record<string, string | undefined>) {
  const clean = Object.fromEntries(
    Object.entries(params).filter(([, value]) => value !== undefined && value !== "")
  ) as Record<string, string>;
  return `?${new URLSearchParams(clean).toString()}`;
}

function TeamLine({
  abbr,
  score,
  winner,
  side,
}: {
  abbr: string;
  score: number | null;
  winner: boolean;
  side: "away" | "home";
}) {
  return (
    <div className="flex items-center justify-between gap-4">
      <div className="flex items-center gap-3 min-w-0">
        <div
          className={`w-11 h-11 rounded-2xl border flex items-center justify-center text-sm font-black transition-colors ${
            winner
              ? "bg-[#10b981]/15 border-[#10b981]/35 text-[#10b981]"
              : "bg-[var(--surface-soft)] border-[var(--border)] text-[var(--text)]"
          }`}
        >
          {abbr}
        </div>
        <div className="min-w-0">
          <p className="text-lg font-black uppercase tracking-tight truncate">{abbr}</p>
          <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
            {side === "away" ? "Visitante" : "Local"}
          </p>
        </div>
      </div>

      <p className={`text-3xl font-black tabular-nums ${winner ? "text-[#10b981]" : "text-[var(--text)]"}`}>
        {score ?? "—"}
      </p>
    </div>
  );
}

function GameCard({ game }: { game: GameRow }) {
  const hasScore = game.away_pts !== null && game.home_pts !== null;
  const awayWinner = hasScore && game.winner_abbr === game.away_team_abbr;
  const homeWinner = hasScore && game.winner_abbr === game.home_team_abbr;

  return (
    <article className="group rounded-[1.65rem] bg-[var(--surface)] border border-[var(--border)] p-5 hover:border-[#10b981]/45 hover:bg-[var(--surface-soft)] transition-all">
      <div className="flex items-center justify-between gap-3 mb-5">
        <div className="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-black/10 px-3 py-1">
          {hasScore ? <Trophy size={13} className="text-[#10b981]" /> : <Clock size={13} className="text-[var(--text-muted)]" />}
          <span className={`text-[10px] font-black uppercase tracking-widest ${hasScore ? "text-[#10b981]" : "text-[var(--text-muted)]"}`}>
            {hasScore ? "Final" : "Programado"}
          </span>
        </div>

        <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
          {shortDate(game.game_date)}
        </p>
      </div>

      <div className="space-y-4">
        <TeamLine abbr={game.away_team_abbr} score={game.away_pts} winner={awayWinner} side="away" />
        <div className="h-px bg-[var(--border)]" />
        <TeamLine abbr={game.home_team_abbr} score={game.home_pts} winner={homeWinner} side="home" />
      </div>

      <div className="mt-5 flex items-center justify-between gap-3">
        <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
          {game.away_team_abbr} @ {game.home_team_abbr}
        </p>
        <p className="text-[10px] font-black uppercase tracking-widest text-[#10b981]">
          {hasScore && game.winner_abbr ? `Ganó ${game.winner_abbr}` : "Sin score"}
        </p>
      </div>
    </article>
  );
}

function EmptyState({ selectedDate }: { selectedDate: string }) {
  return (
    <div className="rounded-[1.65rem] bg-[var(--surface)] border border-[var(--border)] p-10 text-center">
      <div className="mx-auto w-14 h-14 rounded-2xl bg-[var(--surface-soft)] border border-[var(--border)] flex items-center justify-center text-[#10b981] mb-4">
        <CalendarDays size={24} />
      </div>
      <h2 className="text-2xl font-black uppercase tracking-tight">Sin partidos en esta fecha</h2>
      <p className="mt-2 text-sm text-[var(--text-muted)]">
        No hay juegos cargados para {selectedDate || "la fecha seleccionada"}.
      </p>
    </div>
  );
}

export default async function WNBADashboardPage({ searchParams }: { searchParams?: RawSearchParams }) {
  const sp = await Promise.resolve(searchParams ?? {});

  const season = getOne(sp.season, "2025");
  const seasonType = getOne(sp.season_type, "Regular Season");
  const dateParam = getOne(sp.date, "");

  const supabaseUrl = process.env.SUPABASE_URL || process.env.NEXT_PUBLIC_SUPABASE_URL;
  const supabaseKey =
    process.env.SUPABASE_SERVICE_KEY ||
    process.env.SUPABASE_SERVICE_ROLE_KEY ||
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

  if (!supabaseUrl || !supabaseKey) {
    return (
      <main className="min-h-screen p-6 md:p-10 text-[var(--text)]">
        <div className="rounded-2xl border border-red-500/30 bg-red-500/10 p-6">
          <h1 className="text-xl font-black uppercase">Faltan variables de Supabase</h1>
          <p className="mt-2 text-sm text-[var(--text-muted)]">
            Revisá SUPABASE_URL y SUPABASE_SERVICE_KEY en tu .env.local.
          </p>
        </div>
      </main>
    );
  }

  const supabase = createClient(supabaseUrl, supabaseKey, {
    auth: { persistSession: false },
  });

  const latestRes = await supabase
    .from("v_wnba_games")
    .select("game_date")
    .eq("season", season)
    .eq("season_type", seasonType)
    .order("game_date", { ascending: false })
    .limit(1);

  const latestDate = ((latestRes.data ?? []) as DateRow[])[0]?.game_date ?? "";
  const selectedDate = dateParam || latestDate;

  const [gamesRes, previousRes, nextRes] = selectedDate
    ? await Promise.all([
        supabase
          .from("v_wnba_games")
          .select("*")
          .eq("season", season)
          .eq("season_type", seasonType)
          .eq("game_date", selectedDate)
          .order("game_id", { ascending: true }),

        supabase
          .from("v_wnba_games")
          .select("game_date")
          .eq("season", season)
          .eq("season_type", seasonType)
          .lt("game_date", selectedDate)
          .order("game_date", { ascending: false })
          .limit(1),

        supabase
          .from("v_wnba_games")
          .select("game_date")
          .eq("season", season)
          .eq("season_type", seasonType)
          .gt("game_date", selectedDate)
          .order("game_date", { ascending: true })
          .limit(1),
      ])
    : [
        { data: [], error: null },
        { data: [], error: null },
        { data: [], error: null },
      ];

  const games = (gamesRes.data ?? []) as GameRow[];
  const previousDate = ((previousRes.data ?? []) as DateRow[])[0]?.game_date;
  const nextDate = ((nextRes.data ?? []) as DateRow[])[0]?.game_date;
  const error = latestRes.error || gamesRes.error || previousRes.error || nextRes.error;

  const completedGames = games.filter((g) => g.away_pts !== null && g.home_pts !== null).length;

  return (
    <main className="min-h-screen p-4 pt-20 md:pt-8 md:p-8 text-[var(--text)]">
      <section className="relative overflow-hidden rounded-[2rem] border border-[var(--border)] bg-[radial-gradient(circle_at_top_right,rgba(16,185,129,0.16),transparent_38%),var(--surface)] p-6 md:p-8 mb-6">
        <div className="absolute inset-0 opacity-[0.04] bg-[linear-gradient(to_right,#fff_1px,transparent_1px),linear-gradient(to_bottom,#fff_1px,transparent_1px)] bg-[size:34px_34px]" />

        <div className="relative flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
          <div>
            <p className="text-xs font-black uppercase tracking-[0.35em] text-[#10b981]">
              MoskProps WNBA Lab
            </p>
            <h1 className="mt-3 text-5xl md:text-7xl font-black italic uppercase tracking-tighter leading-none">
              Jornada <span className="text-[#10b981]">WNBA</span>
            </h1>
            <p className="mt-4 text-sm md:text-base text-[var(--text-muted)] font-medium max-w-2xl">
              Partidos por fecha. Limpio, directo y sin saturar el dashboard con rankings.
            </p>
          </div>

          <form className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 w-full xl:max-w-4xl">
            <select
              name="season"
              defaultValue={season}
              className="bg-[var(--surface)] border border-[var(--border)] rounded-xl px-4 py-3 text-sm font-black outline-none"
            >
              <option value="2025">2025</option>
              <option value="2024">2024</option>
            </select>

            <select
              name="season_type"
              defaultValue={seasonType}
              className="bg-[var(--surface)] border border-[var(--border)] rounded-xl px-4 py-3 text-sm font-black outline-none"
            >
              <option value="Regular Season">Regular Season</option>
              <option value="Playoffs">Playoffs</option>
            </select>

            <input
              type="date"
              name="date"
              defaultValue={selectedDate}
              className="bg-[var(--surface)] border border-[var(--border)] rounded-xl px-4 py-3 text-sm font-black outline-none"
            />

            <button className="rounded-xl bg-[#10b981] text-black px-5 py-3 text-xs font-black uppercase tracking-widest hover:opacity-90 transition">
              Ver fecha
            </button>
          </form>
        </div>
      </section>

      {error && (
        <div className="mb-6 rounded-2xl border border-red-500/30 bg-red-500/10 p-4 text-sm">
          <p className="font-black uppercase">Error consultando Supabase</p>
          <p className="text-[var(--text-muted)] mt-1">{error.message}</p>
        </div>
      )}

      <section className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div className="md:col-span-2 rounded-2xl bg-[var(--surface)] border border-[var(--border)] p-5">
          <div className="flex items-center gap-3">
            <div className="w-11 h-11 rounded-xl bg-[#10b981]/10 border border-[#10b981]/20 flex items-center justify-center text-[#10b981]">
              <CalendarDays size={20} />
            </div>
            <div>
              <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
                Fecha seleccionada
              </p>
              <p className="text-xl md:text-2xl font-black capitalize">{fmtDate(selectedDate)}</p>
            </div>
          </div>
        </div>

        <div className="rounded-2xl bg-[var(--surface)] border border-[var(--border)] p-5">
          <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">Partidos</p>
          <p className="mt-2 text-4xl font-black tracking-tighter">{games.length}</p>
          <p className="text-xs font-bold text-[var(--text-muted)]">En esta jornada</p>
        </div>

        <div className="rounded-2xl bg-[var(--surface)] border border-[var(--border)] p-5">
          <p className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">Finalizados</p>
          <p className="mt-2 text-4xl font-black tracking-tighter text-[#10b981]">{completedGames}</p>
          <p className="text-xs font-bold text-[var(--text-muted)]">Con resultado cargado</p>
        </div>
      </section>

      <section className="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6">
        <div className="flex flex-wrap gap-2">
          {previousDate && (
            <Link
              href={qs({ season, season_type: seasonType, date: previousDate })}
              className="inline-flex items-center gap-2 rounded-xl bg-[var(--surface)] border border-[var(--border)] px-4 py-2 text-xs font-black uppercase tracking-widest text-[var(--text-muted)] hover:text-[#10b981] hover:border-[#10b981]/30 transition"
            >
              <ArrowLeft size={14} />
              {shortDate(previousDate)}
            </Link>
          )}

          {nextDate && (
            <Link
              href={qs({ season, season_type: seasonType, date: nextDate })}
              className="inline-flex items-center gap-2 rounded-xl bg-[var(--surface)] border border-[var(--border)] px-4 py-2 text-xs font-black uppercase tracking-widest text-[var(--text-muted)] hover:text-[#10b981] hover:border-[#10b981]/30 transition"
            >
              {shortDate(nextDate)}
              <ArrowRight size={14} />
            </Link>
          )}
        </div>

        <div className="flex flex-wrap gap-2">
          <Link
            href="/wnba/teams"
            className="inline-flex items-center gap-2 rounded-xl bg-[var(--surface)] border border-[var(--border)] px-4 py-2 text-xs font-black uppercase tracking-widest text-[var(--text-muted)] hover:text-[#10b981] hover:border-[#10b981]/30 transition"
          >
            <Shield size={14} />
            Equipos
          </Link>
          <Link
            href="/wnba/players"
            className="inline-flex items-center gap-2 rounded-xl bg-[var(--surface)] border border-[var(--border)] px-4 py-2 text-xs font-black uppercase tracking-widest text-[var(--text-muted)] hover:text-[#10b981] hover:border-[#10b981]/30 transition"
          >
            <Users size={14} />
            Jugadoras
          </Link>
        </div>
      </section>

      {games.length > 0 ? (
        <section className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {games.map((game) => (
            <GameCard key={game.game_id} game={game} />
          ))}
        </section>
      ) : (
        <EmptyState selectedDate={selectedDate} />
      )}

      <section className="mt-6 rounded-2xl bg-[var(--surface)] border border-[var(--border)] p-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <p className="text-[10px] font-black uppercase tracking-[0.28em] text-[#10b981]">
            Próximo paso
          </p>
          <h2 className="mt-1 text-xl font-black uppercase tracking-tight">Análisis por equipo y jugadora</h2>
          <p className="mt-1 text-sm text-[var(--text-muted)]">
            Entrá a equipos para navegar roster y abrir el Player Lab de cada jugadora.
          </p>
        </div>

        <Link
          href="/wnba/teams"
          className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#10b981] text-black px-5 py-3 text-xs font-black uppercase tracking-widest hover:opacity-90 transition"
        >
          Explorar equipos
          <ChevronRight size={15} />
        </Link>
      </section>
    </main>
  );
}