"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import {
  Bar,
  BarChart,
  CartesianGrid,
  Cell,
  LabelList,
  ReferenceLine,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";

type PlayerChartProps = {
  data: any[];
  statKey?: string;
  lineValue: number;
  overlayKey?: string;
  overlayLabel?: string;
  overlayColor?: string;
  overlayRatioLabel?: string;
};

const CHART_HEIGHT = 470;
const FALLBACK_WIDTH = 900;

function formatDate(value: any) {
  if (!value) return "S/D";
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return String(value).slice(0, 10);
  return d.toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit" });
}

function getOpponent(row: any) {
  return (
    row.opponent ||
    row.opp ||
    row.matchup_opponent ||
    row.opponent_team ||
    row.vs_team ||
    row.team_abbreviation_opp ||
    "S/D"
  );
}

function getMinutes(row: any) {
  const raw = row.min ?? row.minutes ?? row.min_sec ?? row.period_minutes;
  if (raw === null || raw === undefined || raw === "") return "S/D";
  return String(raw);
}

function CustomTooltip({ active, payload }: any) {
  if (!active || !payload?.length) return null;

  const row = payload[0]?.payload;
  if (!row) return null;

  const value = Number(row.value);
  const line = Number(row.lineValue);
  const over = Number.isFinite(value) && Number.isFinite(line) && value >= line;

  return (
    <div className="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-3 shadow-2xl">
      <div className="text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
        {formatDate(row.game_date)} · vs {getOpponent(row)}
      </div>

      <div className={`mt-2 text-3xl font-black ${over ? "text-[#10b981]" : "text-red-500"}`}>
        {Number.isFinite(value) ? value : "S/D"}
      </div>

      <div className="mt-1 text-[10px] font-bold text-[var(--text-muted)]">
        Línea: {Number.isFinite(line) ? line : "S/D"} · MIN: {getMinutes(row)}
      </div>

      {row.game_result && (
        <div className="mt-1 text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">
          Resultado: {row.game_result}
        </div>
      )}
    </div>
  );
}

function ValueLabel(props: any) {
  const { x, y, width, value } = props;
  const n = Number(value);

  if (!Number.isFinite(n)) return null;

  return (
    <text
      x={x + width / 2}
      y={y - 8}
      textAnchor="middle"
      fill="var(--text)"
      fontSize={10}
      fontWeight={900}
    >
      {Number.isInteger(n) ? n : n.toFixed(1)}
    </text>
  );
}

export default function PlayerChart({
  data,
  statKey = "value",
  lineValue,
}: PlayerChartProps) {
  const wrapRef = useRef<HTMLDivElement | null>(null);
  const [chartWidth, setChartWidth] = useState(FALLBACK_WIDTH);

  useEffect(() => {
    const el = wrapRef.current;
    if (!el) return;

    const measure = () => {
      const rect = el.getBoundingClientRect();
      const width = Math.floor(rect.width || el.clientWidth || FALLBACK_WIDTH);
      setChartWidth(Math.max(320, width));
    };

    measure();

    const ro = new ResizeObserver(measure);
    ro.observe(el);

    window.addEventListener("resize", measure);

    return () => {
      ro.disconnect();
      window.removeEventListener("resize", measure);
    };
  }, []);

  const chartData = useMemo(() => {
    return Array.isArray(data)
      ? data
          .map((row) => {
            const rawValue = Number(row?.[statKey]);
            return {
              ...row,
              value: Number.isFinite(rawValue) ? rawValue : 0,
              lineValue,
            };
          })
          .sort((a, b) => {
            const da = new Date(a.game_date).getTime();
            const db = new Date(b.game_date).getTime();
            return da - db;
          })
      : [];
  }, [data, statKey, lineValue]);

  const hasRows = chartData.length > 0;
  const hasRealValues = chartData.some((row) => Number(row.value) > 0);

  console.log("[PlayerChart DEBUG]", {
    rows: chartData.length,
    width: chartWidth,
    statKey,
    lineValue,
    firstRows: chartData.slice(0, 5).map((r) => ({
      game_date: r.game_date,
      value: r.value,
      pts: r.pts,
      reb: r.reb,
      ast: r.ast,
      fg3m: r.fg3m,
      split_code: r.split_code,
    })),
  });

  if (!hasRows) {
    return (
      <div className="flex h-[470px] w-full min-w-0 items-center justify-center rounded-2xl border border-dashed border-red-500/40 bg-red-500/5 p-6 text-center">
        <div>
          <p className="text-sm font-black uppercase tracking-widest text-red-400">
            Sin datos para graficar
          </p>
          <p className="mt-2 text-xs font-bold text-[var(--text-muted)]">
            PlayerChart recibió data vacía. El problema está antes del gráfico.
          </p>
        </div>
      </div>
    );
  }

  if (!hasRealValues) {
    return (
      <div className="flex h-[470px] w-full min-w-0 items-center justify-center rounded-2xl border border-dashed border-yellow-500/40 bg-yellow-500/5 p-6 text-center">
        <div>
          <p className="text-sm font-black uppercase tracking-widest text-yellow-400">
            Hay {chartData.length} partidos, pero la métrica vale 0
          </p>
          <p className="mt-2 text-xs font-bold text-[var(--text-muted)]">
            El gráfico recibe filas, pero <code>{statKey}</code> viene todo en 0.
          </p>
        </div>
      </div>
    );
  }

  return (
    <div
      ref={wrapRef}
      className="w-full min-w-0 overflow-hidden relative"
      style={{ height: CHART_HEIGHT, minHeight: CHART_HEIGHT }}
    >
      <BarChart
        width={chartWidth}
        height={CHART_HEIGHT}
        data={chartData}
        margin={{ top: 36, right: 30, left: -10, bottom: 38 }}
      >
        <CartesianGrid vertical={false} stroke="rgba(148,163,184,0.22)" />

        <XAxis
          dataKey="game_date"
          tickFormatter={formatDate}
          tick={{ fill: "var(--text-muted)", fontSize: 10, fontWeight: 900 }}
          axisLine={false}
          tickLine={false}
        />

        <YAxis
          tick={{ fill: "var(--text-muted)", fontSize: 10, fontWeight: 900 }}
          axisLine={false}
          tickLine={false}
          allowDecimals={false}
          domain={[0, "dataMax + 5"]}
        />

        <Tooltip content={<CustomTooltip />} />

        <ReferenceLine
          y={lineValue}
          stroke="#ffffff"
          strokeWidth={2}
          strokeDasharray="6 4"
          label={{
            value: `Línea ${lineValue}`,
            position: "right",
            fill: "#10b981",
            fontSize: 11,
            fontWeight: 900,
          }}
        />

        <Bar
          dataKey="value"
          radius={[8, 8, 0, 0]}
          maxBarSize={58}
          minPointSize={3}
          isAnimationActive={false}
        >
          <LabelList content={<ValueLabel />} />

          {chartData.map((row, index) => (
            <Cell
              key={`bar-${row.game_id || row.game_date || index}`}
              fill={Number(row.value) >= Number(lineValue) ? "#10b981" : "#ef4444"}
            />
          ))}
        </Bar>
      </BarChart>
    </div>
  );
}
