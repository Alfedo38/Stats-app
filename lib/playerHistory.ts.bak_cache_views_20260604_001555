import prisma from "@/lib/prisma";
import { roundNumber } from "@/lib/formatters";

export type HistoryMode = "last2" | "all";
export type HistorySide = "over" | "under";

const MARKET_TO_COLUMN: Record<string, string> = {
  PTS: "pts",
  REB: "reb",
  AST: "ast",
  PRA: "pra",
  PR: "pr",
  PA: "pa",
  RA: "ra",
  FGM: "fgm",
  FGA: "fga",
  "3PT": "fg3m",
  "3PM": "fg3m",
  "3PTM": "fg3m",
  "3PTA": "fg3a",
  BLK: "blk",
  STL: "stl",
  "STL+BLK": "stl_blk",
  STOCKS: "stl_blk",
  TO: "tov",
  TOV: "tov",
  PF: "pf",
};

function num(value: any): number {
  if (value === null || value === undefined || value === "") return 0;
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
}

function normalizeDate(value: any): string | null {
  if (!value) return null;
  if (value instanceof Date) return value.toISOString().slice(0, 10);
  const raw = String(value);
  const m = raw.match(/^\d{4}-\d{2}-\d{2}/);
  if (m) return m[0];
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? null : d.toISOString().slice(0, 10);
}

function normalizeTeam(value: any): string | null {
  const raw = String(value || "").trim().toUpperCase();
  return raw || null;
}

function normalizeHomeAway(value: any): "HOME" | "AWAY" | null {
  const raw = String(value || "").trim().toUpperCase();
  if (["HOME", "H", "LOCAL", "CASA"].includes(raw)) return "HOME";
  if (["AWAY", "A", "ROAD", "VISITANTE", "VISITA"].includes(raw)) return "AWAY";
  return null;
}

function normalizeName(value: any): string {
  return String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9]+/g, " ")
    .trim()
    .toLowerCase();
}

function extractMinutes(row: any): number | null {
  return roundNumber(
    row.min_clean ??
    row.minutes_clean ??
    row.min_decimal ??
    row.minutes_decimal ??
    row.min ??
    row.minutes ??
    row.min_sec ??
    row.minutes_played ??
    row.mp ??
    null,
    1
  );
}

function percentile(values: number[], p: number): number | null {
  if (!values.length) return null;
  const sorted = values.slice().sort((a, b) => a - b);
  const idx = Math.min(sorted.length - 1, Math.max(0, Math.floor((sorted.length - 1) * p)));
  return sorted[idx];
}

function median(values: number[]): number | null {
  if (!values.length) return null;
  const sorted = values.slice().sort((a, b) => a - b);
  const mid = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
}

function getSeasonKey(row: any): string {
  const raw = String(row.season_id ?? row.season ?? "").trim();
  if (raw) return raw;
  const d = normalizeDate(row.game_date);
  if (!d) return "S/D";
  const year = Number(d.slice(0, 4));
  const month = Number(d.slice(5, 7));
  const start = month >= 10 ? year : year - 1;
  return `${start}-${String((start + 1) % 100).padStart(2, "0")}`;
}

function getMarketValue(row: any, market: string): number {
  const col = MARKET_TO_COLUMN[String(market || "").toUpperCase()] || String(market || "").toLowerCase();
  if (col === "pra") return num(row.pra ?? row.pts_reb_ast ?? row.pts + row.reb + row.ast);
  if (col === "pr") return num(row.pr ?? row.pts_reb ?? row.pts + row.reb);
  if (col === "pa") return num(row.pa ?? row.pts_ast ?? row.pts + row.ast);
  if (col === "ra") return num(row.ra ?? row.reb_ast ?? row.reb + row.ast);
  if (col === "stl_blk") return num(row.stl_blk ?? row.stocks ?? num(row.stl) + num(row.blk));
  return num(row[col]);
}

function summarizeGames(rows: any[], market: string, line: number, side: HistorySide) {
  const values = rows.map((r) => getMarketValue(r, market));
  const minutes = rows.map(extractMinutes).filter((m): m is number => m !== null);
  const hits = rows.filter((r) => {
    const value = getMarketValue(r, market);
    return side === "over" ? value >= line : value <= line;
  }).length;

  const games = rows.length;
  const avg = values.length ? values.reduce((a, b) => a + b, 0) / values.length : null;
  const med = median(values);
  const avgMin = minutes.length ? minutes.reduce((a, b) => a + b, 0) / minutes.length : null;

  return {
    games,
    hits,
    misses: Math.max(0, games - hits),
    hitRate: games ? hits / games : null,
    avg,
    median: med,
    p25: percentile(values, 0.25),
    p75: percentile(values, 0.75),
    avgMinutes: avgMin,
  };
}

function round(value: any, digits = 1) {
  const n = Number(value);
  if (!Number.isFinite(n)) return null;
  return Number(n.toFixed(digits));
}

function formatGame(row: any, market: string, line: number, side: HistorySide) {
  const value = getMarketValue(row, market);
  const hit = side === "over" ? value >= line : value <= line;
  return {
    game_id: row.game_id ?? null,
    game_date: normalizeDate(row.game_date),
    season_id: getSeasonKey(row),
    matchup: row.matchup_clean ?? row.matchup ?? null,
    opponent: row.opponent_clean ?? row.opponent ?? null,
    home_away: row.home_away_clean ?? row.home_away ?? null,
    minutes: round(extractMinutes(row), 1),
    min_display: row.min_display ?? null,
    value,
    pts: num(row.pts),
    reb: num(row.reb),
    ast: num(row.ast),
    pra: num(row.pra ?? row.pts + row.reb + row.ast),
    pr: num(row.pr ?? row.pts + row.reb),
    pa: num(row.pa ?? row.pts + row.ast),
    ra: num(row.ra ?? row.reb + row.ast),
    fgm: num(row.fgm),
    fga: num(row.fga),
    fg3m: num(row.fg3m),
    fg3a: num(row.fg3a),
    blk: num(row.blk),
    stl: num(row.stl),
    stl_blk: num(row.stl_blk ?? num(row.stl) + num(row.blk)),
    tov: num(row.tov ?? row.to),
    pf: num(row.pf),
    usage_pct: row.usage_pct === null || row.usage_pct === undefined ? null : num(row.usage_pct),
    touches: row.touches === null || row.touches === undefined ? null : num(row.touches),
    potential_ast: row.potential_ast === null || row.potential_ast === undefined ? null : num(row.potential_ast),
    rebound_chances: row.rebound_chances === null || row.rebound_chances === undefined ? null : num(row.rebound_chances),
    hit,
  };
}


export async function getPlayerHistoricalExplorer(input: {
  playerId?: string | number | null;
  playerName?: string | null;
  market: string;
  line: number;
  side?: HistorySide;
  mode?: HistoryMode;
  opponent?: string | null;
  homeAway?: "HOME" | "AWAY" | string | null;
  minMinutes?: number | null;
  woTeammate?: string | null;
  limit?: number;
}) {
  const market = String(input.market || "PTS").toUpperCase();
  const line = Number(input.line);
  const side: HistorySide = input.side === "under" ? "under" : "over";
  const mode: HistoryMode = input.mode === "all" ? "all" : "last2";
  const opponent = normalizeTeam(input.opponent);
  const homeAway = normalizeHomeAway(input.homeAway);
  const minMinutes = input.minMinutes === null || input.minMinutes === undefined ? null : Number(input.minMinutes);
  const woTeammate = String(input.woTeammate || "").trim();
  const requestedLimit = Number(input.limit || 1000);
  // Permitir L5 real. Antes el mínimo era 20 y por eso, aunque la URL tuviera n=5,
  // el histórico devolvía 20 partidos y el gráfico/tooltip quedaba desincronizado.
  const limit = Math.min(Math.max(Number.isFinite(requestedLimit) ? requestedLimit : 1000, 1), 1000);
  const playerId = input.playerId != null && String(input.playerId).trim() ? String(input.playerId).trim() : null;
  const playerName = String(input.playerName || "").trim();

  if (!Number.isFinite(line)) throw new Error("line inválida");
  if (!MARKET_TO_COLUMN[market]) throw new Error(`Mercado histórico no soportado: ${market}`);
  if (!playerId && !playerName) throw new Error("playerId o playerName requerido");

  const allowedSources = [
    "public.player_page_game_fact_cache",
    "nba_api_data.v_ludo_player_page_history_unified",
    "nba_api_data.v_ludo_hist_player_games",
  ];

  const nameTokens = normalizeName(playerName).split(" ").filter((t) => t.length >= 2);
  const primaryFirst = nameTokens[0] || "";
  const primaryLast = nameTokens.length > 1 ? nameTokens[nameTokens.length - 1] : "";

  async function runQuery(source: string, whereSql: string, params: any[]) {
    if (!allowedSources.includes(source)) throw new Error("Fuente histórica no permitida");
    return prisma.$queryRawUnsafe<any[]>(
      `
      SELECT *
      FROM ${source}
      WHERE ${whereSql}
      ORDER BY game_date DESC
      LIMIT 2000
      `,
      ...params
    );
  }

  async function querySource(source: string) {
    // Prioridad 1: nombre exacto. Esto evita colisiones de IDs entre ESPN/current y NBA API histórico.
    if (playerName) {
      let rows = await runQuery(source, `player_name ILIKE $1`, [playerName]);
      if (rows?.length) return { rows, matchMode: "name_exact", source };

      // Prioridad 2: nombre aproximado por primer + último token.
      // Ej: Victor Wembanyama, Nikola Jokic/Jokić, C.J. McCollum.
      if (primaryFirst && primaryLast && primaryFirst !== primaryLast) {
        rows = await runQuery(
          source,
          `lower(player_name) LIKE $1 AND lower(player_name) LIKE $2`,
          [`%${primaryFirst}%`, `%${primaryLast}%`]
        );
        if (rows?.length) return { rows, matchMode: "name_tokens", source };
      }
    }

    // Fallback final por id solamente si no hay forma de resolver por nombre.
    // No lo usamos primero porque el mismo número puede apuntar a otro jugador en fuentes distintas.
    if (playerId && !playerName) {
      const rows = await runQuery(source, `player_id::text = $1::text`, [playerId]);
      if (rows?.length) return { rows, matchMode: "player_id", source };
    }

    return { rows: [], matchMode: "none", source };
  }

  let queryResult: { rows: any[]; matchMode: string; source: string } | null = null;

  for (const source of allowedSources) {
    try {
      const result = await querySource(source);
      if (result.rows.length) {
        queryResult = result;
        break;
      }
    } catch (error: any) {
      // La vista unificada es recomendada pero opcional. Si todavía no corriste el SQL,
      // caemos a v_ludo_hist_player_games sin romper la página.
      if (!String(error?.message || "").includes("v_player_page_game_fact") && !String(error?.message || "").includes("v_ludo_player_page_history_unified")) {
        console.warn("No se pudo leer fuente histórica", source, error?.message || error);
      }
    }
  }

  let rows = queryResult?.rows || [];
  const matchMode = queryResult?.matchMode || "none";
  const source = queryResult?.source || allowedSources[allowedSources.length - 1];

  if (woTeammate) {
    try {
      const woRows = await prisma.$queryRawUnsafe<any[]>(
        `
        SELECT game_id::text AS game_id, game_date::date AS game_date
        FROM public.v_ludo_wo_games_modal
        WHERE player_id::text = $1::text
          AND absent_teammate ILIKE $2
        ORDER BY game_date DESC NULLS LAST
        LIMIT 3000
        `,
        String(playerId || ""),
        woTeammate
      );

      const woGameIds = new Set((woRows || []).map((r) => String(r.game_id || "")).filter(Boolean));
      const woDates = new Set((woRows || []).map((r) => normalizeDate(r.game_date)).filter(Boolean) as string[]);

      rows = rows.filter((row) => {
        const gid = row.game_id === null || row.game_id === undefined ? "" : String(row.game_id);
        const date = normalizeDate(row.game_date);
        return (gid && woGameIds.has(gid)) || (date && woDates.has(date));
      });
    } catch (error: any) {
      console.warn("No pude aplicar filtro W/O", woTeammate, error?.message || error);
      rows = [];
    }
  }

  const allRows = (rows || []).map((r) => ({ ...r, _season_key: getSeasonKey(r), _minutes: extractMinutes(r) }));
  const seasons = Array.from(new Set(allRows.map((r) => r._season_key).filter(Boolean))).sort().reverse();
  const last2Seasons = seasons.slice(0, 2);
  const fromAll = allRows.length ? normalizeDate(allRows[allRows.length - 1].game_date) : null;
  const toAll = allRows.length ? normalizeDate(allRows[0].game_date) : null;

  const baseRows = mode === "last2" && last2Seasons.length
    ? allRows.filter((r) => last2Seasons.includes(r._season_key))
    : allRows;

  const minutesFiltered = Number.isFinite(minMinutes)
    ? baseRows.filter((r) => r._minutes !== null && Number(r._minutes) >= Number(minMinutes))
    : baseRows;

  const venueFiltered = homeAway
    ? minutesFiltered.filter((r) => normalizeHomeAway(r.home_away_clean ?? r.home_away) === homeAway)
    : minutesFiltered;

  const filteredRows = opponent
    ? venueFiltered.filter((r) => normalizeTeam(r.opponent_clean ?? r.opponent) === opponent)
    : venueFiltered;

  const opponentAllRows = opponent ? allRows.filter((r) => normalizeTeam(r.opponent_clean ?? r.opponent) === opponent) : [];
  const opponentWithMinutes = opponent && Number.isFinite(minMinutes)
    ? opponentAllRows.filter((r) => r._minutes !== null && Number(r._minutes) >= Number(minMinutes))
    : opponentAllRows;

  const summary = summarizeGames(filteredRows, market, line, side);
  const opponentSummary = opponent ? summarizeGames(opponentWithMinutes, market, line, side) : null;
  const last30 = summarizeGames(filteredRows.slice(0, 30), market, line, side);
  const last20 = summarizeGames(filteredRows.slice(0, 20), market, line, side);
  const last10 = summarizeGames(filteredRows.slice(0, 10), market, line, side);
  const last5 = summarizeGames(filteredRows.slice(0, 5), market, line, side);

  const seasonBreakdown = seasons.map((season) => {
    const seasonRows = filteredRows.filter((r) => r._season_key === season);
    return {
      season,
      ...summarizeGames(seasonRows, market, line, side),
    };
  }).filter((s) => s.games > 0);

  return {
    ok: true,
    mode,
    side,
    market,
    line,
    opponent,
    homeAway,
    minMinutes: Number.isFinite(minMinutes) ? Number(minMinutes) : null,
    woTeammate: woTeammate || null,
    source,
    matchMode,
    coverage: {
      from: fromAll,
      to: toAll,
      games: allRows.length,
      seasons,
      selectedSeasons: mode === "last2" ? last2Seasons : seasons,
    },
    summary: {
      ...summary,
      hitRatePct: summary.hitRate === null ? null : round(summary.hitRate * 100, 1),
      avg: round(summary.avg, 1),
      median: round(summary.median, 1),
      p25: round(summary.p25, 1),
      p75: round(summary.p75, 1),
      avgMinutes: round(summary.avgMinutes, 1),
    },
    recent: {
      l5: { ...last5, hitRatePct: last5.hitRate === null ? null : round(last5.hitRate * 100, 1) },
      l10: { ...last10, hitRatePct: last10.hitRate === null ? null : round(last10.hitRate * 100, 1) },
      l20: { ...last20, hitRatePct: last20.hitRate === null ? null : round(last20.hitRate * 100, 1) },
      l30: { ...last30, hitRatePct: last30.hitRate === null ? null : round(last30.hitRate * 100, 1) },
    },
    opponentSummary: opponentSummary ? {
      ...opponentSummary,
      hitRatePct: opponentSummary.hitRate === null ? null : round(opponentSummary.hitRate * 100, 1),
      avg: round(opponentSummary.avg, 1),
      median: round(opponentSummary.median, 1),
      avgMinutes: round(opponentSummary.avgMinutes, 1),
    } : null,
    seasonBreakdown: seasonBreakdown.map((s) => ({
      ...s,
      hitRatePct: s.hitRate === null ? null : round(s.hitRate * 100, 1),
      avg: round(s.avg, 1),
      median: round(s.median, 1),
      avgMinutes: round(s.avgMinutes, 1),
    })),
    games: filteredRows.slice(0, limit).map((r) => formatGame(r, market, line, side)),
  };
}
