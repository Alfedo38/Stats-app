generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model players {
  id         Int     @id
  first_name String?
  last_name  String?
  full_name  String?
}

model teams {
  id           Int     @id
  name         String? // Asegúrate que diga name y NO full_name
  abbreviation String?
  city         String?
  conference   String?
  division     String?
}

model player_game_logs {
  id                Int       @id @default(autoincrement())
  player_id         Int
  player_name       String?
  pts               Int?
  reb               Int?
  ast               Int?
  game_date         DateTime?
  team_abbreviation String?
}

model player_odds {
  id          Int     @id @default(autoincrement())
  player_name String
  prop_type   String
  line        Float
  matchup     String?
}