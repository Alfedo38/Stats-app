generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model player_game_logs {
  id                Int       @id @default(autoincrement())
  player_id         Int?
  player_name       String?   @db.VarChar(100)
  game_date         DateTime? @db.Date
  matchup           String?   @db.VarChar(50)
  wl                String?   @db.VarChar(2)
  min               String?   @db.VarChar(10)
  pts               Int?
  reb               Int?
  ast               Int?
  stl               Int?
  blk               Int?
  tov               Int?
  pf                Int?
  fgm               Int?
  fga               Int?
  fg3m              Int?
  fg3a              Int?
  team_abbreviation String?   @db.VarChar(10)
  season_year       String?   @db.VarChar(20)
  min_sec           String?   @db.VarChar(20)
  team_count        Int?
  nickname          String?   @db.VarChar(100)
}

model player_odds {
  id          Int       @id @default(autoincrement())
  player_name String?   @db.VarChar(100)
  matchup     String?   @db.VarChar(100)
  market      String?   @db.VarChar(50)
  line        Float?
  over_price  Int?
  under_price Int?
  last_update DateTime? @default(now()) @db.Timestamp(6)
}

model players {
  id         Int      @id
  first_name String?  @db.VarChar(100)
  last_name  String?  @db.VarChar(100)
  team_id    Int?
  full_name  String?  @db.VarChar(150)
  is_active  Boolean?
  teams      teams?   @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model teams {
  id           Int       @id @default(autoincrement())
  name         String?   @db.VarChar(100)
  abbreviation String?   @unique @db.VarChar(10)
  city         String?   @db.VarChar(100)
  conference   String?   @db.VarChar(50)
  division     String?   @db.VarChar(50)
  players      players[]
}
